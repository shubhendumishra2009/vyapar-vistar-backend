{
  "name": "vyapar-vistar-desktop",
  "version": "1.0.0",
  "description": "VyaparVistar - Desktop Business Management App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "dist": "electron-builder --publish=never"
  },
  "author": "A2Wares",
  "license": "MIT",
  "dependencies": {
    "electron": "^28.0.0",
    "electron-store": "^8.1.0",
    "node-machine-id": "^1.1.0",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.a2wares.vyaparvistar",
    "productName": "VyaparVistar",
    "copyright": "Copyright © 2024 A2Wares",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}